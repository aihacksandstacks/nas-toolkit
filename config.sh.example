#!/bin/bash
# nas-toolkit configuration
# Copy this file to config.sh and edit with your NAS settings
#
# cp config.sh.example config.sh
# Then edit config.sh with your values

# NAS Connection
export NAS_HOSTNAME="your-nas-hostname"      # Friendly name for your NAS
export NAS_IP="100.x.x.x"                    # Tailscale IP or local IP

# Connection paths (nas-mount / nas-health try LAN first, then Tailscale)
export NAS_TS_IP="${NAS_IP}"            # Tailscale address
export NAS_LAN_IP="192.168.1.x"         # LAN address (leave empty to use Tailscale only)
export NAS_USER="your-username"              # SMB/SSH username for NAS
# Password is handled by macOS Keychain - mount via Finder first to save credentials
export NAS_SSH_HOST="nas"                    # SSH config alias (created by nas-setup)

# SMB Mount Settings
export NAS_SMB_SHARE="personal_folder"           # SMB share name on NAS (your home share keeps data private)
export NAS_MOUNT_POINT="/Volumes/personal_folder"  # Where macOS mounts it (NetFS uses /Volumes/<share>)

# Docker
export NAS_DOCKER_CONTEXT="nas"

# NAS paths (where data is stored on the NAS)
export NAS_SHARE_ROOT="/home/your-username"      # NAS path the SMB share exposes; maps 1:1 to NAS_MOUNT_POINT
export NAS_STORAGE_BASE="${NAS_SHARE_ROOT}/mac-offload"  # Offload root inside the share
export NAS_CACHE_DIR="${NAS_STORAGE_BASE}/caches"
export NAS_ARCHIVE_DIR="${NAS_STORAGE_BASE}/archives"
export NAS_DOCKER_DIR="${NAS_STORAGE_BASE}/docker"

# Local paths to offload
export LOCAL_NPM_CACHE="$HOME/.npm"
export LOCAL_PIP_CACHE="$HOME/Library/Caches/pip"
export LOCAL_PYPOETRY_CACHE="$HOME/Library/Caches/pypoetry"
export LOCAL_HOMEBREW_CACHE="$HOME/Library/Caches/Homebrew"
export LOCAL_CARGO_CACHE="$HOME/.cargo"
export LOCAL_UV_CACHE="$HOME/.cache/uv"

# Colors for output (don't change)
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'
export PURPLE='\033[0;35m'
export CYAN='\033[0;36m'
export NC='\033[0m' # No Color
export BOLD='\033[1m'

# Toolkit version
export NAS_TOOLKIT_VERSION="1.0.0"

# Time Machine health (tm-health). Only needed if you back up to this NAS.
export NAS_TM_SHARE_PATH="/volume1/TimeMachine"       # NAS path of the Time Machine share
export NAS_SMB_SHARE_CONF="/etc/samba/smbshare.conf"  # Samba share config on the NAS
export TM_MIN_FREE_GB=100          # Warn when share free space drops below this
export TM_RECYCLE_WARN_GB=10       # Warn when the share recycle bin exceeds this
export TM_MAX_LOCAL_SNAPSHOTS=3    # Warn when the Mac holds more local snapshots
export TM_MAX_BACKUP_AGE_HOURS=48  # Warn when the last completed backup is older
