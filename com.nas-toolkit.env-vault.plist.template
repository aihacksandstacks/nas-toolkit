<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nas-toolkit.env-vault</string>

    <!-- Encrypting needs only the public key, so this runs unattended.
         It skips the run when no file changed since the last archive. -->
    <key>ProgramArguments</key>
    <array>
        <string>__TOOLKIT_DIR__/bin/env-vault</string>
        <string>backup</string>
    </array>

    <!-- Daily at 21:30. If the Mac was asleep, launchd runs it on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/nas-env-vault.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/nas-env-vault.log</string>
</dict>
</plist>
