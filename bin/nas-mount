#!/bin/zsh
#
# nas-mount - Mount the NAS share, LAN first, Tailscale as fallback.
#
# Uses NetFS with UI suppressed (bin/nas-netfs-mount), so a failed mount
# never pops a Finder "Connect to Server" dialog. Credentials come from the
# login Keychain: save them once per host by connecting in Finder (Cmd+K).
#
# Exit codes: 0 mounted, 1 mount failed, 3 NAS unreachable on every path.
#

SCRIPT_DIR="${0:A:h}"
TOOLKIT_ROOT="${SCRIPT_DIR:h}"
source "$TOOLKIT_ROOT/config.sh"
source "$TOOLKIT_ROOT/lib/nas-endpoint.sh"

if is_mounted && mount_alive; then
    echo "NAS already mounted at $NAS_MOUNT_POINT via $(endpoint_label "$(mounted_host)")"
    exit 0
fi

if is_mounted; then
    echo "Existing mount is unresponsive, force-unmounting..."
    unmount_share force
fi

host=$(pick_endpoint)
if [ -z "$host" ]; then
    echo "NAS not reachable (LAN ${NAS_LAN_IP:-unset}, Tailscale $NAS_TS_IP)"
    exit 3
fi

echo "Mounting $NAS_SMB_SHARE via $(endpoint_label "$host") ($host)..."
if mount_from "$host"; then
    echo "Mounted successfully at $NAS_MOUNT_POINT"
    exit 0
fi

echo "Mount failed. If this is a new host, connect once in Finder (Cmd+K: smb://${NAS_USER}@${host}/${NAS_SMB_SHARE}) and save the password to Keychain."
exit 1
