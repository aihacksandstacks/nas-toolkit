#!/bin/zsh
#
# dev-archive - Archive inactive projects to the NAS
#
# Writes <project>.tar.gz plus a .json manifest to the archives folder on the
# NAS share, reads the archive back to verify it, and only then (with --clean)
# deletes the local copy. The archive keeps .git, stashes, unpushed branches
# and untracked files such as .env; it leaves out directories a package manager
# rebuilds (node_modules, .venv, Pods, ...).
#
# Usage:
#   dev-archive --suggest [DAYS]      # List projects idle DAYS+ days (default 90)
#   dev-archive <project>             # Archive and verify, keep local copy
#   dev-archive <project> --clean     # ...then delete the local copy
#   dev-archive --list                # List archives on the NAS
#   dev-restore <name>                # Bring one back
#
set -e

SCRIPT_PATH="${0:A}"   # $0 is the function name inside functions
SCRIPT_DIR="${SCRIPT_PATH:h}"
source "$SCRIPT_DIR/../lib/common.sh"

DEV_DIR="${DEV_ARCHIVE_DEV_DIR:-$HOME/dev}"
ARCHIVE_DIR="$(nas_to_mount_path "$NAS_ARCHIVE_DIR")/repos"

# Directory names a package manager or build tool regenerates.
REBUILDABLE=(node_modules .venv venv __pycache__ .next .turbo .expo .parcel-cache
             .pnpm-store Pods DerivedData .gradle .pytest_cache .mypy_cache .ruff_cache)

show_help() {
    sed -n '2,18p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'
    cat << EOF

Options:
    --clean       Delete the local copy after the archive verifies
    --force       Skip confirmation prompts
    -h, --help    Show this help
EOF
}

# Make sure the NAS share is mounted; try nas-mount once.
require_mount() {
    if [ ! -d "${ARCHIVE_DIR:h}" ]; then
        "$SCRIPT_DIR/nas-mount" >/dev/null 2>&1 || true
    fi
    if [ ! -d "${ARCHIVE_DIR:h}" ]; then
        log_error "NAS archive folder not reachable: ${ARCHIVE_DIR:h}"
        log_info "Mount the share with nas-mount, then retry"
        exit 1
    fi
    mkdir -p "$ARCHIVE_DIR"
}

# Echo "yes" if any file outside .git and rebuildable dirs changed within DAYS.
recently_touched() {
    local dir=$1 days=$2
    local -a expr=( \( -name .git )
    for d in $REBUILDABLE; do expr+=( -o -name "$d" ); done
    expr+=( \) -prune -o -type f -mtime "-$days" -print -quit )
    [ -n "$(find "$dir" "${expr[@]}" 2>/dev/null)" ] && echo yes || echo no
}

git_status_summary() {
    local dir=$1
    if [ ! -d "$dir/.git" ]; then
        echo "no git"
        return
    fi
    local dirty=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    local unpushed=$(git -C "$dir" log --branches --not --remotes --oneline 2>/dev/null | wc -l | tr -d ' ')
    local stashes=$(git -C "$dir" stash list 2>/dev/null | wc -l | tr -d ' ')
    local -a parts
    (( dirty )) && parts+=("$dirty dirty")
    (( unpushed )) && parts+=("$unpushed unpushed")
    (( stashes )) && parts+=("$stashes stash")
    [ -z "$(git -C "$dir" remote 2>/dev/null)" ] && parts+=("no remote")
    echo "${${(j:, :)parts}:-clean, pushed}"
}

linked_worktrees() {
    git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' | tail -n +2
}

suggest() {
    local days=${1:-90}
    print_header "Projects idle ${days}+ days in $DEV_DIR"
    printf "  ${BOLD}%-36s %8s  %-11s %s${NC}\n" "PROJECT" "SIZE" "LAST COMMIT" "STATE"
    local found=0
    for dir in "$DEV_DIR"/*(N/); do
        [ -d "$dir/.git" ] || continue
        [ "$(recently_touched "$dir" "$days")" = yes ] && continue
        local last=$(git -C "$dir" log -1 --format=%cs 2>/dev/null || echo "-")
        local state=$(git_status_summary "$dir")
        local wts=$(linked_worktrees "$dir" | wc -l | tr -d ' ')
        (( wts )) && state="$state, $wts worktrees"
        printf "  %-36s %8s  %-11s %s\n" "${dir:t}" "$(get_dir_size "$dir")" "$last" "$state"
        found=$((found + 1))
    done
    (( found )) || log_success "Nothing idle for ${days}+ days"
    echo ""
    log_info "Sizes include node_modules etc., which the archive leaves out."
    log_info "Archive one with: dev-archive <path> --clean"
}

list_archives() {
    require_mount
    print_header "Archives in $ARCHIVE_DIR"
    local any=false
    for f in "$ARCHIVE_DIR"/*.tar.gz(N); do
        any=true
        local name=${f:t:r:r}
        local remote="-"
        [ -f "${f:r:r}.json" ] && remote=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("git_remote") or "-")' "${f:r:r}.json" 2>/dev/null)
        printf "  %-36s %8s  %s  %s\n" "$name" "$(du -h "$f" | cut -f1)" "$(stat -f %Sm -t %Y-%m-%d "$f")" "$remote"
    done
    $any || log_info "No archives yet"
}

write_manifest() {
    local out=$1; shift
    python3 -I - "$out" "$@" << 'PY'
import json, sys
out, *pairs = sys.argv[1:]
data = dict(zip(pairs[::2], pairs[1::2]))
for k in ("file_count", "unpushed_commits", "dirty_files", "stashes"):
    if k in data and data[k].isdigit():
        data[k] = int(data[k])
with open(out, "w") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
PY
}

archive_project() {
    local dir=${1:A} clean=$2 force=$3
    [ -d "$dir" ] || { log_error "Not a directory: $dir"; return 1; }

    if [ -f "$dir/.git" ]; then
        log_error "$dir is a linked git worktree. Remove it with: git worktree remove $dir"
        return 1
    fi
    local wts=$(linked_worktrees "$dir")
    if [ -n "$wts" ]; then
        log_error "$dir has linked worktrees; archiving would orphan them:"
        echo "$wts" | sed 's/^/    /'
        log_info "Remove them first (git worktree remove <path>)"
        return 1
    fi

    require_mount
    local name=${dir:t}
    local final="$ARCHIVE_DIR/$name.tar.gz"
    local partial="$final.partial"
    local manifest="$ARCHIVE_DIR/$name.json"

    local remote="" branch="" head="" dirty=0 unpushed=0 stashes=0
    if [ -d "$dir/.git" ]; then
        remote=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
        branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)
        head=$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)
        dirty=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        unpushed=$(git -C "$dir" log --branches --not --remotes --oneline 2>/dev/null | wc -l | tr -d ' ')
        stashes=$(git -C "$dir" stash list 2>/dev/null | wc -l | tr -d ' ')
    fi

    print_header "Archiving $name"
    print_kv "Source" "$dir"
    print_kv "Destination" "$final"
    print_kv "Git" "$(git_status_summary "$dir")"
    print_kv "Delete local after" "$clean"
    echo ""
    if ! $force && ! confirm "Archive $name?"; then
        log_info "Cancelled"
        return 0
    fi

    local -a excludes
    for d in $REBUILDABLE; do excludes+=(--exclude "$d"); done
    [ -f "$dir/Cargo.toml" ] && excludes+=(--exclude "./$name/target")

    log_step "Writing archive to the NAS"
    local listing=$(mktemp)
    # bsdtar -v prints one "a <path>" line per entry on stderr.
    if ! tar -czvf "$partial" "${excludes[@]}" -C "${dir:h}" "$name" 2> "$listing"; then
        log_error "tar failed:"; tail -5 "$listing"; rm -f "$partial" "$listing"; return 1
    fi
    local written=$(grep -c '^a ' "$listing" || true)
    rm -f "$listing"

    log_step "Verifying (reading the archive back)"
    local readback=$(tar -tzf "$partial" | wc -l | tr -d ' ')
    if [ "$readback" != "$written" ]; then
        log_error "Verify failed: wrote $written entries, read back $readback. Local copy kept."
        rm -f "$partial"
        return 1
    fi
    local sha=$(shasum -a 256 "$partial" | cut -d' ' -f1)

    if [ -f "$final" ]; then
        local stamp=$(stat -f %Sm -t %Y%m%d-%H%M%S "$final")
        mv "$final" "$ARCHIVE_DIR/$name.$stamp.tar.gz"
        [ -f "$manifest" ] && mv "$manifest" "$ARCHIVE_DIR/$name.$stamp.json"
        log_info "Kept previous archive as $name.$stamp.tar.gz"
    fi
    mv "$partial" "$final"
    write_manifest "$manifest" \
        name "$name" original_path "$dir" git_remote "$remote" branch "$branch" head "$head" \
        dirty_files "$dirty" unpushed_commits "$unpushed" stashes "$stashes" \
        file_count "$written" sha256 "$sha" archived_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    log_success "Archived $written entries ($(du -h "$final" | cut -f1)), sha256 ${sha:0:12}"

    if $clean; then
        if $force || confirm "Delete local copy $dir?"; then
            local before=$(df -k /System/Volumes/Data | awk 'NR==2{print $4}')
            rm -rf "$dir"
            local after=$(df -k /System/Volumes/Data | awk 'NR==2{print $4}')
            log_success "Deleted local copy, freed $(( (after - before) / 1024 ))MB"
        else
            log_info "Local copy kept"
        fi
    fi
    log_info "Restore with: dev-restore $name"
}

ACTION=""
TARGET=""
DAYS=90
CLEAN=false
FORCE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) show_help; exit 0 ;;
        -l|--list) ACTION=list; shift ;;
        -s|--suggest|--stale)
            ACTION=suggest; shift
            [[ "$1" =~ ^[0-9]+$ ]] && { DAYS=$1; shift; }
            ;;
        --clean) CLEAN=true; shift ;;
        --force) FORCE=true; shift ;;
        --all)
            log_error "--all was removed: it deleted every match without asking. Use --suggest, then archive each project."
            exit 1
            ;;
        -*) log_error "Unknown option: $1"; show_help; exit 1 ;;
        *) ACTION=archive; TARGET=$1; shift ;;
    esac
done

case "$ACTION" in
    list) list_archives ;;
    suggest) suggest "$DAYS" ;;
    archive) archive_project "$TARGET" "$CLEAN" "$FORCE" ;;
    *) show_help ;;
esac
