# Template for /volume1/docker/vaultwarden/.env on the NAS.
# install-on-nas.sh creates the real file from this one. The real .env never goes in git.

DOMAIN=https://black-betty.tail584407.ts.net:10443
TZ=America/New_York
LOG_LEVEL=warn

# true only while you create your own account. install-on-nas.sh --lock-signups
# flips it to false and recreates the container.
SIGNUPS_ALLOWED=true
