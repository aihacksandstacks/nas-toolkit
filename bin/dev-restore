#!/bin/zsh
#
# dev-restore - Restore a project archived with dev-archive
#
# Checks the archive against the sha256 in its manifest, then extracts it from
# the NAS share. It never overwrites an existing directory.
#
# Usage:
#   dev-restore <name>                 # Restore to ~/dev/<name>
#   dev-restore <name> --to <dir>      # Restore to <dir>/<name>
#   dev-restore <name> --delete-archive  # Remove the archive after restoring
#   dev-restore --list                 # List archives (same as dev-archive --list)
#
set -e

SCRIPT_PATH="${0:A}"   # $0 is the function name inside functions
SCRIPT_DIR="${SCRIPT_PATH:h}"
source "$SCRIPT_DIR/../lib/common.sh"

ARCHIVE_DIR="$(nas_to_mount_path "$NAS_ARCHIVE_DIR")/repos"

show_help() {
    sed -n '2,13p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'
}

manifest_get() {
    python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")' "$1" "$2" 2>/dev/null
}

restore_project() {
    local name=${1%.tar.gz} target_root=${2:-$HOME/dev} delete_archive=$3
    local archive="$ARCHIVE_DIR/$name.tar.gz"
    local manifest="$ARCHIVE_DIR/$name.json"
    local dest="$target_root/$name"

    if [ ! -d "$ARCHIVE_DIR" ]; then
        "$SCRIPT_DIR/nas-mount" >/dev/null 2>&1 || true
    fi
    [ -f "$archive" ] || { log_error "No archive: $archive (dev-restore --list)"; return 1; }
    if [ -e "$dest" ]; then
        log_error "$dest already exists; move it aside or pass --to <dir>"
        return 1
    fi

    print_header "Restoring $name"
    print_kv "Archive" "$archive ($(du -h "$archive" | cut -f1))"
    print_kv "Restore to" "$dest"
    if [ -f "$manifest" ]; then
        print_kv "Archived at" "$(manifest_get "$manifest" archived_at)"
        print_kv "Original path" "$(manifest_get "$manifest" original_path)"
        print_kv "Git remote" "$(manifest_get "$manifest" git_remote)"
    fi
    echo ""
    confirm "Restore $name?" || { log_info "Cancelled"; return 0; }

    if [ -f "$manifest" ]; then
        local want=$(manifest_get "$manifest" sha256)
        if [ -n "$want" ]; then
            log_step "Checking sha256"
            local got=$(shasum -a 256 "$archive" | cut -d' ' -f1)
            if [ "$got" != "$want" ]; then
                log_error "sha256 mismatch (manifest ${want:0:12}, file ${got:0:12}); not extracting"
                return 1
            fi
        fi
    fi

    log_step "Extracting"
    mkdir -p "$target_root"
    tar -xzf "$archive" -C "$target_root"
    log_success "Restored to $dest"

    if $delete_archive; then
        rm -f "$archive" "$manifest"
        log_info "Removed archive from the NAS"
    fi

    echo ""
    log_info "Dependencies were not archived. Reinstall them:"
    [ -f "$dest/pnpm-lock.yaml" ] && echo "  pnpm install"
    [ -f "$dest/package-lock.json" ] && echo "  npm ci"
    [ -f "$dest/yarn.lock" ] && echo "  yarn install"
    [ -f "$dest/uv.lock" ] && echo "  uv sync"
    [ -f "$dest/requirements.txt" ] && [ ! -f "$dest/uv.lock" ] && echo "  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
    [ -f "$dest/Podfile" ] && echo "  pod install"
    return 0
}

NAME=""
TO=""
DELETE=false
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) show_help; exit 0 ;;
        -l|--list) exec "$SCRIPT_DIR/dev-archive" --list ;;
        --to) TO=$2; shift 2 ;;
        --delete-archive) DELETE=true; shift ;;
        --keep-archive) shift ;;  # default; kept for old muscle memory
        -*) log_error "Unknown option: $1"; show_help; exit 1 ;;
        *) NAME=$1; shift ;;
    esac
done

[ -n "$NAME" ] || { show_help; exit 1; }
restore_project "$NAME" "$TO" "$DELETE"
