#!/bin/zsh
#
# nas-health - Keep the NAS share mounted over the best available path.
#
# Run by launchd every 5 minutes AND whenever the network changes (Wi-Fi
# join/leave, Tailscale up/down, wake from sleep). Each run:
#   - remounts if the share dropped, preferring LAN over Tailscale
#   - force-unmounts a dead mount (server gone) instead of letting it hang
#   - moves an idle Tailscale mount onto the LAN once you are home
#   - backs off after 3 failed mounts, and auto-resumes on the next network
#     change or after 30 minutes
#
# Usage:
#   nas-health          # Normal check (run by launchd)
#   nas-health status   # Show state, mount and endpoint reachability
#   nas-health resume   # Clear back-off and check immediately
#

SCRIPT_DIR="${0:A:h}"
TOOLKIT_ROOT="${SCRIPT_DIR:h}"
source "$TOOLKIT_ROOT/config.sh"
source "$TOOLKIT_ROOT/lib/nas-endpoint.sh"

STATE_DIR="$HOME/.nas-toolkit"
STATE_FILE="$STATE_DIR/health-state"      # failures:status:last_state
NETSIG_FILE="$STATE_DIR/network-signature"
PAUSED_AT_FILE="$STATE_DIR/paused-at"
MAX_FAILURES=3
RESUME_AFTER_SECONDS=1800
mkdir -p "$STATE_DIR"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [nas-health] $*"; }
notify() { osascript -e "display notification \"$1\" with title \"NAS Toolkit\"" 2>/dev/null; }

get_state() { [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "0:running:ok"; }
set_state() { echo "$1:$2:$3" > "$STATE_FILE"; }

# Changes whenever the Mac's route to the world changes (new Wi-Fi, VPN up/down).
network_signature() {
    { route -n get default 2>/dev/null | awk '/gateway|interface/ {print $2}'
      ifconfig 2>/dev/null | awk '/^utun|^en/ {i=$1} /inet 100\./ {print i}'
    } | tr '\n' ' '
}

IFS=':' read -r FAILURES STATUS LAST_STATE <<< "$(get_state)"

case "$1" in
    resume)
        set_state 0 "running" "$LAST_STATE"
        rm -f "$PAUSED_AT_FILE"
        log "Resumed monitoring"
        exec "$0"
        ;;
    status)
        echo "NAS Health Status:"
        echo "  Consecutive failures: $FAILURES"
        echo "  Status: $STATUS"
        echo "  Last check: $LAST_STATE"
        if is_mounted; then
            alive=$(mount_alive && echo "responsive" || echo "UNRESPONSIVE")
            echo "  Mount: $NAS_MOUNT_POINT via $(endpoint_label "$(mounted_host)") ($(mounted_host)), $alive"
        else
            echo "  Mount: not connected"
        fi
        lan="unreachable"; smb_port_open "$NAS_LAN_IP" && lan="SMB open"
        [ "$lan" = "SMB open" ] && ! has_keychain_creds "$NAS_LAN_IP" && lan="SMB open, no Keychain password"
        echo "  LAN ${NAS_LAN_IP:-unset}: $lan"
        ts="unreachable"; smb_port_open "$NAS_TS_IP" && ts="SMB open"
        echo "  Tailscale $NAS_TS_IP: $ts"
        exit 0
        ;;
    help|--help|-h)
        sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

# Let a network change settle (DHCP, Tailscale reconnect) before probing.
sleep "${NAS_SETTLE_SECONDS:-3}"

# Back-off: resume automatically when the network changes or time has passed.
sig=$(network_signature)
old_sig=$(cat "$NETSIG_FILE" 2>/dev/null)
echo "$sig" > "$NETSIG_FILE"
if [ "$STATUS" = "paused" ]; then
    paused_at=$(cat "$PAUSED_AT_FILE" 2>/dev/null || echo 0)
    if [ "$sig" != "$old_sig" ] || [ $(( $(date +%s) - paused_at )) -ge $RESUME_AFTER_SECONDS ]; then
        log "Auto-resuming after back-off (network changed or $((RESUME_AFTER_SECONDS / 60)) min elapsed)"
        FAILURES=0; STATUS="running"
        set_state 0 "running" "$LAST_STATE"
        rm -f "$PAUSED_AT_FILE"
    else
        exit 0
    fi
fi

# --- Already mounted: verify it is alive and on the best path ------------------
if is_mounted; then
    current=$(mounted_host)
    if ! mount_alive; then
        log "Mount via $(endpoint_label "$current") is unresponsive, force-unmounting"
        unmount_share force
    else
        if [ "$current" != "$NAS_LAN_IP" ] && lan_ready; then
            # Home again: move to the LAN, but only if nothing holds files open.
            if unmount_share; then
                log "LAN available, moving mount from $(endpoint_label "$current") to LAN"
            else
                log "LAN available but share is busy, staying on $(endpoint_label "$current")"
            fi
        fi
        if is_mounted; then
            [ "$LAST_STATE" = "failed" ] && notify "NAS reconnected"
            set_state 0 "running" "ok"
            log "OK, mounted via $(endpoint_label "$(mounted_host)")"
            exit 0
        fi
    fi
fi

# --- Not mounted: mount from the best reachable endpoint ----------------------
host=$(pick_endpoint)
if [ -z "$host" ]; then
    log "NAS unreachable on LAN and Tailscale, will retry on next network change"
    exit 0
fi

if out=$(mount_from "$host"); then
    set_state 0 "running" "ok"
    log "Mounted via $(endpoint_label "$host") ($host)"
    notify "NAS mounted via $(endpoint_label "$host")"
    exit 0
fi

FAILURES=$((FAILURES + 1))
log "Mount via $(endpoint_label "$host") failed ($FAILURES/$MAX_FAILURES): $out"
if [ $FAILURES -ge $MAX_FAILURES ]; then
    set_state $FAILURES "paused" "failed"
    date +%s > "$PAUSED_AT_FILE"
    log "Backing off until the network changes or $((RESUME_AFTER_SECONDS / 60)) min pass"
    notify "NAS mount failing, backing off. Run: nas-health status"
else
    set_state $FAILURES "running" "failed"
fi
